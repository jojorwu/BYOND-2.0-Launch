<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="Launcher.Views.UpdateDialog"
        Title="Доступно обновление!"
        WindowStartupLocation="CenterOwner"
        Width="500"
        Height="350">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="DownloadButton" Content="Скачать" Margin="10" />
            <Button Name="LaterButton" Content="Позже" Margin="10" />
        </StackPanel>
        <TextBlock Name="MessageTextBlock" Text="Новая версия доступна!" Margin="15" TextWrapping="Wrap" />
    </DockPanel>
</Window>
