<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Launcher"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Launcher.MainWindow"
>
    <Window.Resources>
        <local:FavoriteToColorConverter x:Key="FavoriteToColorConverter"/>
    </Window.Resources>
        x:DataType="local:MainWindow"
        Title="BYOND 2.0 Launcher"
        Width="850" Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="15">

        <!-- Top Bar with Title and Refresh Button -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="10" CornerRadius="5">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="Серверы" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="RefreshAllButton" Content="Обновить все" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center"/>
                <TextBox Name="SearchBox" Watermark="Поиск по названию или IP..." Width="250"/>
                <CheckBox Name="FavoritesFilter" Content="Только избранные"/>
            </StackPanel>
        </Border>

        <!-- Server List -->
        <DataGrid Grid.Row="2" Name="ServerList" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserResizeColumns="True" CanUserSortColumns="False"
                  ItemsSource="{Binding FilteredServers}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="IP Адрес" Binding="{Binding IpAddress}" Width="2*"/>
                <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="Auto"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
                <DataGridTextColumn Header="Пинг" Binding="{Binding Ping}" Width="Auto"/>
                <DataGridTemplateColumn Header="Избранное">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:Server">
                            <Button Content="★"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteToColorConverter}}"
                                    Click="FavoriteButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Bar with Action Buttons and Status -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10" CornerRadius="5">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto">
                <TextBlock Grid.Column="0" Name="StatusText" Text="Готово" VerticalAlignment="Center" Opacity="0.7"/>

                <Button Grid.Column="1" Name="AddButton" Content="Добавить" Margin="5,0"/>
                <Button Grid.Column="2" Name="EditButton" Content="Изменить" Margin="5,0"/>
                <Button Grid.Column="3" Name="DeleteButton" Content="Удалить" Margin="5,0"/>
                <Button Grid.Column="4" Name="ConnectButton" Content="Подключиться" Margin="15,0,0,0"
                        Classes="accent"/>
            </Grid>
        </Border>
    </Grid>
</Window>
