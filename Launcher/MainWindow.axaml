<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Launcher.MainWindow"
        Title="BYOND 2.0 Launcher"
        Width="600" Height="350">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Left" Width="200" Margin="0,0,10,0" Spacing="5">
            <TextBlock FontSize="18" FontWeight="Bold">Servers</TextBlock>
            <Border Padding="5" BorderThickness="1" BorderBrush="Gray">
                <ListBox Name="ServerList" SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Server}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox IsChecked="{Binding IsFavorite}" IsEnabled="False" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <Panel>
            <StackPanel VerticalAlignment="Top">
                <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,10">Server Details</TextBlock>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,10">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">Name:</TextBlock>
                    <TextBox Grid.Row="0" Grid.Column="1" Name="NameTextBox" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,0">IP Address:</TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Name="IpAddressTextBox" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,0">Port:</TextBlock>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Name="PortTextBox" />
                </Grid>

                <CheckBox Name="FavoriteCheckBox" Content="Favorite" Margin="0,0,0,10"
                          Checked="FavoriteCheckBox_Changed" Unchecked="FavoriteCheckBox_Changed" />

                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button Name="AddButton" Click="AddButton_Click" Content="Add"/>
                    <Button Name="DeleteButton" Click="DeleteButton_Click" Content="Delete"/>
                </StackPanel>
            </StackPanel>

            <Button Name="ConnectButton" Click="ConnectButton_Click" Content="Connect"
                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                    IsDefault="True"/>
        </Panel>

        <TextBlock Name="ErrorTextBlock" DockPanel.Dock="Bottom" Foreground="Red" Margin="0,10,0,0"
                   TextWrapping="Wrap" IsVisible="False"/>
    </DockPanel>
</Window>
