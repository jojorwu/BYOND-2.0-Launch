<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Launcher.MainWindow"
        Title="BYOND 2.0 Launcher"
        Width="600" Height="350">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Left" Width="200" Margin="0,0,10,0" Spacing="5">
            <TextBlock FontSize="18" FontWeight="Bold">Servers</TextBlock>
            <Border Padding="5" BorderThickness="1" BorderBrush="Gray">
                <ListBox Name="ServerList" SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Server}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsFavorite}" IsEnabled="False" />
                                <TextBlock Text="{Binding Name}" Margin="5,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <Panel>
            <Border Padding="10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="Server Details" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">Name:</TextBlock>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="NameTextBox" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,0">IP Address:</TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Name="IpAddressTextBox" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,0">Port:</TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Name="PortTextBox" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5,10,0">Favorite:</TextBlock>
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,5,0,0" Name="FavoriteCheckBox" Click="FavoriteCheckBox_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,10,0,0">
                        <Button Name="NewServerButton" Click="NewServerButton_Click" Content="New"/>
                        <Button Name="AddButton" Click="AddButton_Click" Content="Add"/>
                        <Button Name="DeleteButton" Click="DeleteButton_Click" Content="Delete"/>
                        <Button Name="ConnectButton" Click="ConnectButton_Click" Content="Connect" IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Name="StatusTextBlock" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
        </Panel>
    </DockPanel>
</Window>
