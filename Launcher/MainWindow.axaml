<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Launcher"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Launcher.MainWindow"
        Title="BYOND 2.0 Launcher"
        Width="800" Height="450">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Left" Padding="10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <StackPanel Width="220" Spacing="10">
                <TextBlock FontSize="18" FontWeight="Bold">Servers</TextBlock>
                <Button Name="RefreshButton" Click="RefreshButton_Click" Content="Refresh All"/>
                <ListBox Name="ServerList" SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Server}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="★" IsVisible="{Binding IsFavorite}" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gold" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="Gray" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Panel Margin="10,0,0,0">
            <Border Padding="10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock Text="Server Details" FontWeight="Bold" FontSize="18"/>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Top">
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">Name:</TextBlock>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="NameTextBox" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">IP Address:</TextBlock>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="IpAddressTextBox" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">Port:</TextBlock>
                        <TextBox Grid.Row="2" Grid.Column="1" Name="PortTextBox" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">Favorite:</TextBlock>
                        <CheckBox Grid.Row="3" Grid.Column="1" Name="FavoriteCheckBox" Click="FavoriteCheckBox_Click" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                        <Button Name="NewServerButton" Click="NewServerButton_Click" Content="New"/>
                        <Button Name="SaveButton" Click="SaveButton_Click" Content="Save"/>
                        <Button Name="DeleteButton" Click="DeleteButton_Click" Content="Delete"/>
                        <Button Name="ConnectButton" Click="ConnectButton_Click" Content="Connect" IsDefault="True" Classes="accent"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Name="StatusTextBlock" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"/>
        </Panel>
    </DockPanel>
</Window>
