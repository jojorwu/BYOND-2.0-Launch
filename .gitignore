## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Installer output
installer/
BYOND_2.0_Linux.tar.gz

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if you don't use solution-level packages restoration
#!packages/repositories.config
# NuGet v3's project.json lock file
project.lock.json

# Roslyn files
.vs/

# Test results
*.trx
*.xunit
test-explorer/

# Local History for Visual Studio Code
.history/

# Log files
*.log
